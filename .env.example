NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
DATABASE_URL=postgresql://vibecheck:vibecheck_local_only@localhost:5432/vibecheck
DATABASE_SSL=false
WEB_ORIGINS=http://localhost:5173
GIT_COMMIT=local
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=25
AUTH_ENABLED=false
AUTH_COOKIE_SECURE=false
VITE_AUTH_ENABLED=true
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_OTP_TTL_SECONDS=600
AUTH_OTP_RESEND_SECONDS=60
AUTH_EMAIL_SEND_LIMIT=5
AUTH_IP_SEND_LIMIT=20
AUTH_RATE_WINDOW_SECONDS=900
EMAIL_PROVIDER=resend
EMAIL_FROM=VibeCheck <login@example.com>
RESEND_API_KEY=
EMAIL_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
EMAIL_ENCRYPTION_KEY_VERSION=dev-v1
EMAIL_HASH_PEPPER=replace-with-at-least-32-random-characters
OTP_PEPPER=replace-with-at-least-32-random-characters
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
CATALOG_ENABLED=false
CATALOG_CURSOR_SECRET=replace-with-at-least-32-random-characters
CATALOG_DEFAULT_PAGE_SIZE=24
CATALOG_MAXIMUM_PAGE_SIZE=50
SEARCH_ENABLED=false
SEARCH_ENCRYPTION_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
SEARCH_ENCRYPTION_KEY_VERSION=dev-v1
SEARCH_SUBJECT_HASH_PEPPER=replace-with-at-least-32-random-characters
SEARCH_RESULT_TOKEN_SECRET=replace-with-at-least-32-random-characters
SEARCH_SUBJECT_COOKIE_SECRET=replace-with-at-least-32-random-characters
SEARCH_SNAPSHOT_TTL_SECONDS=86400
SEARCH_PAGE_SIZE=20
SEARCH_MAXIMUM_STORED_RESULTS=100
SEARCH_RAW_QUERY_LIMIT=30
SEARCH_RAW_QUERY_RATE_WINDOW_SECONDS=900
COMPARISON_ENABLED=false
COMPARISON_SUBJECT_HASH_PEPPER=replace-with-at-least-32-random-characters
COMPARISON_SUBJECT_COOKIE_SECRET=replace-with-at-least-32-random-characters
COMPARISON_ANONYMOUS_TTL_SECONDS=604800
COMPARISON_MAXIMUM_VISIBLE_MS_PER_EVENT=60000
ANALYTICS_ENABLED=false
ANALYTICS_SESSION_SECRET=replace-with-at-least-32-random-characters
ANALYTICS_SUBJECT_HASH_PEPPER=replace-with-at-least-32-random-characters
ANALYTICS_SESSION_TTL_SECONDS=86400
# Set only after the applicable consent/legal policy is approved: granted or not_required.
ANALYTICS_CONSENT_STATE=
COMMUNITY_ENABLED=false
COMMUNITY_CURSOR_SECRET=replace-with-at-least-32-random-characters
COMMUNITY_REPORT_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
COMMUNITY_REPORT_ENCRYPTION_KEY_VERSION=dev-v1
COMMUNITY_COMMENT_PAGE_SIZE=20
